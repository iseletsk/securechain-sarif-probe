{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "securechain",
          "version": "0.0.0-probe",
          "informationUri": "https://tuxcare.com/securechain",
          "rules": [
            {
              "id": "securechain-refusal",
              "name": "securechain-refusal",
              "shortDescription": {
                "text": "securechain could not check something: a file it did not read, a version it could not parse, or an advisory source that did not answer. These results do not show that it is safe."
              },
              "fullDescription": {
                "text": "securechain could not check something: a file it did not read, a version it could not parse, or an advisory source that did not answer. These results do not show that it is safe."
              },
              "help": {
                "text": "Read the reason on the alert. `--output json` lists the same item with its file, package and status."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ],
          "notifications": [
            {
              "id": "securechain-refusal",
              "name": "securechain-refusal",
              "shortDescription": {
                "text": "securechain could not check something: a file it did not read, a version it could not parse, or an advisory source that did not answer. These results do not show that it is safe."
              },
              "fullDescription": {
                "text": "securechain could not check something: a file it did not read, a version it could not parse, or an advisory source that did not answer. These results do not show that it is safe."
              },
              "help": {
                "text": "Read the reason on the alert. `--output json` lists the same item with its file, package and status."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "results": [
