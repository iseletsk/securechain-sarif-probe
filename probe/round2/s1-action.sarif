{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "securechain",
          "version": "0.0.0-probe",
          "informationUri": "https://tuxcare.com/securechain",
          "rules": [
            {
              "id": "CVE-2021-23337",
              "name": "CVE-2021-23337",
              "shortDescription": {
                "text": "Command Injection in lodash"
              },
              "fullDescription": {
                "text": "Command Injection in lodash"
              },
              "help": {
                "text": "Each alert for this advisory says how to fix it for its own package: the TuxCare build and the command that installs it, or the upstream versions that fix it."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "7.2",
                "tags": [
                  "security"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CVE-2021-23337",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "pkg:npm/lodash@4.17.20 is affected by CVE-2021-23337 (high): Command Injection in lodash. Upstream fixed this in 4.17.21."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "s1-action/package.json",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 10
                }
              }
            }
          ],
          "partialFingerprints": {
            "securechainVulnKey": "CVE-2021-23337:pkg:npm/lodash@4.17.20:s1-action/package-lock.json:0"
          },
          "properties": {
            "securechain.ecosystem": "npm",
            "securechain.fixed": "4.17.21",
            "securechain.gates": "true",
            "securechain.ids": "CVE-2021-23337",
            "securechain.purl": "pkg:npm/lodash@4.17.20",
            "securechain.rating": "high",
            "securechain.score": "7.2",
            "securechain.severity_source": "cvss3",
            "securechain.source": "lockfile",
            "securechain.status": "open",
            "securechain.version": "4.17.20"
          }
        }
      ]
    }
  ]
}
